<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sign_oca_request_form_provider" model="ir.ui.view">
        <field name="name">sign.oca.request.form.provider</field>
        <field name="model">sign.oca.request</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_request_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="company_id" invisible="1" />
                <button
                    name="action_provider_prepare"
                    type="object"
                    string="Prepare provider"
                    invisible="not provider_id or provider_state not in ['draft', 'failed']"
                />
                <button
                    name="action_provider_start"
                    type="object"
                    string="Start provider"
                    class="btn-primary"
                    invisible="provider_state not in ['draft', 'failed', 'in_progress']"
                />
                <button
                    name="action_provider_refresh"
                    type="object"
                    string="Refresh provider"
                    invisible="provider_state not in ['in_progress']"
                />
            </xpath>

            <xpath
                expr="//field[@name='signer_ids']/tree/field[@name='partner_id']"
                position="after"
            >
                <field name="provider_sign_state" readonly="1" />
                <field name="provider_sign_state_updated_on" readonly="1" />
                <field name="identity_status" readonly="1" />
                <field name="identity_method" readonly="1" />
                <field name="provider_signer_ref" readonly="1" optional="hide" />
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Advanced electronic signature">
                    <group>
                        <field name="provider_id" readonly="state == '2_signed'" />
                        <field name="provider_state" readonly="1" />
                    </group>
                </group>
                <notebook>
                    <page string="Provider transactions">
                        <field name="provider_transaction_ids" readonly="1">
                            <tree>
                                <field name="name" />
                                <field name="provider_id" />
                                <field name="signer_id" />
                                <field name="state" />
                                <field name="external_id" />
                                <field name="original_document_hash" />
                                <field name="signed_document_hash" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="sign_oca_provider_transaction_view_form" model="ir.ui.view">
        <field name="name">sign.oca.provider.transaction.form</field>
        <field name="model">sign.oca.provider.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_start"
                        type="object"
                        string="Start"
                        invisible="state not in ['draft', 'prepared', 'error']"
                    />
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh"
                        invisible="state in ['cancelled', 'rejected', 'validated']"
                    />
                    <button
                        name="action_fetch_artifacts"
                        type="object"
                        string="Fetch artifacts"
                        invisible="state not in ['signed', 'validated']"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ['cancelled', 'rejected', 'validated']"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" />
                            <field name="signer_id" />
                            <field name="provider_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="external_id" />
                            <field name="sign_url" widget="url" />
                            <field name="original_document_hash" />
                            <field name="signed_document_hash" />
                        </group>
                    </group>
                    <group string="Artifacts" groups="base.group_no_one">
                        <field name="signed_document_attachment_id" />
                        <field name="evidence_attachment_id" />
                    </group>
                    <group string="Diagnostics" groups="base.group_no_one">
                        <field name="last_error" />
                        <field name="status_payload" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
