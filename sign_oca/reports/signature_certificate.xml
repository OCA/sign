<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_signature_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sign_oca.report_signature_certificate_doc" />
            </t>
        </t>
    </template>

    <template id="report_signature_certificate_doc">
        <t t-call="web.external_layout">
            <div class="page">
                <h1 class="mb32">Signature Certificate</h1>

                <!-- Document Information -->
                <div class="document_information mb32">
                    <div class="row mb16">
                        <div class="col-12">
                            <h3 class="text-muted">Document Information</h3>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div id="signature_filename" class="mb8">
                                <span class="fw-bold">Signature filename:</span>
                                <span class="text-break" t-field="o.filename" />
                            </div>
                            <div id="created_on" class="mb8">
                                <span class="fw-bold">Created on:</span>
                                <span
                                    t-field="o.create_date"
                                    t-options='{"widget": "datetime", "format": "dd-MM-YYYY HH:mm:ss", "tz_name": "UTC"}'
                                />
                                <span>(UTC)</span>
                            </div>
                            <div id="created_by" class="mb8">
                                <span class="fw-bold">Created by:</span>
                                <span t-field="o.create_uid" />
                            </div>
                            <div id="print_date" class="mb8">
                                <span class="fw-bold">Print date:</span>
                                <span
                                    t-out="datetime.datetime.utcnow().strftime('%d-%m-%Y %H:%M:%S')"
                                />
                                <span>(UTC)</span>
                            </div>
                            <div id="responsible" class="mb8">
                                <span class="fw-bold">Responsible:</span>
                                <span t-field="o.user_id" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div id="document_id" class="mb8">
                                <span class="fw-bold">Document ID:</span>
                                <span t-field="o.id" />
                            </div>
                            <div t-if="o.record_ref" id="related_record" class="mb8">
                                <t
                                    t-set="model_name"
                                    t-value="o.record_ref and o.record_ref.sudo()._name"
                                />
                                <t
                                    t-set="model_display_name"
                                    t-value="model_name and env['ir.model'].sudo().search([('model', '=', model_name)], limit=1).name"
                                />
                                <span class="fw-bold">Related record:</span>
                                <span t-out="model_display_name" />
                                <span>-</span>
                                <span t-field="o.record_ref.sudo().display_name" />
                            </div>
                            <div id="signers" class="mb8">
                                <t
                                    t-set="signer_remaining"
                                    t-value="o.signer_count - o.signed_count"
                                />
                                <span class="fw-bold">Signers:</span>
                                <span t-field="o.signer_count" />
                                <span>signers →</span>
                                <span t-field="o.signed_count" />
                                <span>signed,</span>
                                <span t-out="signer_remaining" />
                                <span>remaining</span>
                            </div>
                            <div id="current_hash" class="mb8">
                                <span class="fw-bold">Current hash:</span>
                                <span class="text-break" t-field="o.current_hash" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Signers -->
                <div t-if="o.signer_ids" class="document_signers mb32">
                    <div class="row mb16">
                        <div id="document_signers_title" class="col-12">
                            <h3 class="text-muted">Signers</h3>
                        </div>
                    </div>
                    <div class="row pt4">
                        <div id="document_signers_table" class="col-12">
                            <table class="table table-bordered">
                                <thead
                                    class="bg-100"
                                    style="border-bottom: 2px solid #dee2e6;"
                                >
                                    <tr>
                                        <th class="text-start">Signer</th>
                                        <th class="text-start">Email</th>
                                        <th class="text-start">Role</th>
                                        <th class="text-start">Signed?</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.signer_ids" t-as="signer">
                                        <tr>
                                            <td t-out="signer.partner_name" />
                                            <td
                                                t-out="signer.partner_id.sudo().email"
                                            />
                                            <td
                                                t-out="signer.role_id.sudo().display_name"
                                            />
                                            <td>
                                                <span
                                                    t-if="signer.inalterable_hash"
                                                >✔</span>
                                                <span t-else="">✘</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Signatures -->
                <t
                    t-set="signature_ids"
                    t-value="o.signer_ids.filtered(lambda s: s.inalterable_hash)"
                />
                <div t-if="signature_ids" class="document_signatures mb32">
                    <div class="row mb16">
                        <div id="document_signatures_title" class="col-12">
                            <h3 class="text-muted">Signatures</h3>
                        </div>
                    </div>
                    <div class="row pt4">
                        <div id="document_signatures_table" class="col-12">
                            <table class="table table-bordered">
                                <thead
                                    class="bg-100"
                                    style="border-bottom: 2px solid #dee2e6;"
                                >
                                    <tr>
                                        <th class="text-start">Signer</th>
                                        <th class="text-start">Signed on</th>
                                        <th class="text-start">Geolocation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="signature_ids" t-as="signature">
                                        <tr>
                                            <td t-out="signature.partner_name" />
                                            <td>
                                                <span
                                                    t-out="signature.signed_on"
                                                    t-options='{"widget": "datetime", "format": "dd-MM-YYYY HH:mm:ss", "tz_name": "UTC"}'
                                                />
                                                <span>(UTC)</span>
                                            </td>
                                            <td>
                                                <t
                                                    t-if="signature.latitude or signature.longitude"
                                                >
                                                    <span t-out="signature.latitude" />
                                                    <span>-</span>
                                                    <span t-out="signature.longitude" />
                                                </t>
                                                <span
                                                    t-else=""
                                                    class="text-muted"
                                                >Not available</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3">
                                                <span
                                                    class="text-muted"
                                                >Inalterability hash:</span>
                                                <span
                                                    class="text-break"
                                                    t-out="signature.inalterable_hash"
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Activity Logs -->
                <t
                    t-set="request_logs"
                    t-value="env['sign.oca.request.log'].sudo().search([('request_id', '=', o.id), ('action', 'in', ['create', 'validate', 'view', 'sign', 'cancel'])])"
                />
                <div t-if="request_logs" class="document_activity_logs mb32">
                    <div class="row mb16">
                        <div id="document_activity_logs_title" class="col-12">
                            <h3 class="text-muted">Activity Logs</h3>
                        </div>
                    </div>
                    <div class="row pt4">
                        <div id="document_activity_logs_table" class="col-12">
                            <table class="table table-bordered">
                                <thead
                                    class="bg-100"
                                    style="border-bottom: 2px solid #dee2e6;"
                                >
                                    <tr>
                                        <th class="text-start">Action</th>
                                        <th class="text-start">Date (UTC)</th>
                                        <th class="text-start">Partner</th>
                                        <th class="text-start">IP address</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="request_logs" t-as="log">
                                        <tr>
                                            <td
                                                t-out="dict(log.fields_get()['action']['selection'])[log.action]"
                                            />
                                            <td
                                                t-out="log.date"
                                                t-options='{"widget": "datetime", "format": "dd-MM-YYYY HH:mm:ss", "tz_name": "UTC"}'
                                            />
                                            <td>
                                                <t t-if="not log.signer_id">
                                                    <span
                                                        t-out="log.partner_id.sudo().name"
                                                    />
                                                </t>
                                                <t t-else="">
                                                    <span
                                                        t-out="log.signer_id.sudo().partner_name"
                                                    />
                                                </t>
                                            </td>
                                            <td>
                                                <t t-if="log.ip">
                                                    <span t-out="log.ip" />
                                                </t>
                                                <t t-else="">
                                                    <span
                                                        class="text-muted"
                                                    >Not available</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
