<odoo>
    <record model="ir.ui.view" id="sign_oca_template_generate_form_view">
        <field name="name">sign.oca.template.generate.form (in sign_oca)</field>
        <field name="model">sign.oca.template.generate</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_template_generate_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='signer_ids']/list/field[@name='partner_id']"
                position="after"
            >
                <field
                    name="phone_id"
                    domain="[('partner_id', '=', partner_id)]"
                    options="{'no_create': True, 'no_open': True}"
                />
            </xpath>
            <button name="generate" position="attributes">
                <attribute name="string">Generate &amp; send email</attribute>
                <attribute name="context">{'send_method': 'email'}</attribute>
                <attribute name="invisible">sign_now</attribute>
            </button>
            <button name="generate" position="after">
                <button
                    name="generate"
                    string="Generate &amp; send sms"
                    class="btn-primary"
                    type="object"
                    context="{'send_method': 'sms'}"
                    invisible="sign_now"
                />
                <button
                    name="generate"
                    string="Generate &amp; send email &amp; sms"
                    class="btn-primary"
                    type="object"
                    context="{'send_method': 'both'}"
                    invisible="sign_now"
                />
                <button
                    name="generate"
                    string="Generate &amp; sign now"
                    class="btn-primary"
                    type="object"
                    invisible="not sign_now"
                />
            </button>
        </field>
    </record>
</odoo>
