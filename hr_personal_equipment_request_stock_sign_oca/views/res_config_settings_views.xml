<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >Add Stock configuration for Requesting Personal Equipment to Configuration Settings</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="hr_personal_equipment_request_sign_oca.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='personal_equipment_request_sign_oca_template_id']/ancestor::div[hasclass('o_setting_box')]"
                position="after"
            >
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="ppe_report_show_sn" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="ppe_report_show_sn" />
                        <div class="text-muted">
                            Show S/N in Personal Equipment Request Report
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
