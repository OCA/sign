<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="survey_user_input_view_form" model="ir.ui.view">
        <field name="name">survey.user.input.view.form</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    type="object"
                    name="action_view_sign_requests"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('sign_request_count', '=', 0)]}"
                    groups="sign_oca.sign_oca_group_user"
                >
                    <field name="sign_request_count" widget="statinfo" />
                </button>
            </div>
        </field>
    </record>
</odoo>
