<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >Add Stock configuration for Requesting Personal Equipment to Configuration Settings</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="hr_personal_equipment_request_sign_oca.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='personal_equipment_request_sign_oca_template_id']/ancestor::setting"
                position="after"
            >
                <setting
                    help="The lot/serial number is displayed for each product moving a lot/serial number."
                >
                    <field name="ppe_report_show_sn" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
