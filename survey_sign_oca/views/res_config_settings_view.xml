<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="93" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="Survey Sign OCA"
                    string="Survey Sign OCA"
                    data-key="survey_sign_oca"
                    groups="sign_oca.sign_oca_group_admin"
                >
                    <h2>Surveys Sign Template</h2>
                    <div
                        class="row mt16 o_settings_container"
                        id="survey_sign_oca_template"
                    >
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label
                                            class="col-md-3 o_light_label"
                                            for="survey_user_input_sign_oca_template_id"
                                            string="Template"
                                        />
                                        <field
                                            name="survey_user_input_sign_oca_template_id"
                                            options="{'no_create': True}"
                                        />
                                        <div class="text-muted">
                                            If you select a template, it will be the default one to create sign requests from surveys.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
