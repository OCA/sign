<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_personal_equipment_request_form_view" model="ir.ui.view">
        <field name="name">personal.equipment.request.form</field>
        <field name="model">hr.personal.equipment.request</field>
        <field
            name="inherit_id"
            ref="hr_personal_equipment_request.hr_personal_equipment_request_form_view"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='action_view_ppe_report']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <div name="button_box" position="inside">
                <button
                    type="object"
                    name="action_view_sign_requests"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    attrs="{'invisible': [('sign_request_count', '=', 0)]}"
                    groups="sign_oca.sign_oca_group_user"
                >
                    <field
                        name="sign_request_count"
                        widget="statinfo"
                        string="Sign Requests"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
