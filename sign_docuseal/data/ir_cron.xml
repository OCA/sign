<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Missed-webhook fallback: reconcile pending submissions against
         GET /api/submissions/<id> once an hour. -->
    <record id="ir_cron_docuseal_reconcile" model="ir.cron">
        <field name="name">DocuSeal: reconcile pending submissions</field>
        <field name="model_id" ref="model_docuseal_submission" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
    </record>
</odoo>
