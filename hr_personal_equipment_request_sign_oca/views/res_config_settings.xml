<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="enrich_employee_setting" position="after">
                <setting
                    help="If this template is set, Personal Equipment Requests automatically generate a Signature Request"
                    groups="sign_oca.sign_oca_group_admin"
                >
                    <field
                        name="personal_equipment_request_sign_oca_template_id"
                        options="{
                            'no_create': True,
                        }"
                    />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
